{
  "expo": {
    "name": "Hermes 移动端",
    "slug": "hermes-mobile",
    "owner": "finstep-intelligent-technology-co-ltd",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/hermes-icon.png",
    "scheme": "hermes-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "hermes.cashcat.cn",
      "appleTeamId": "4SAK5KMM76",
      "buildNumber": "2",
      "icon": "./assets/hermes.icon",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh-Hans",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hermesmobile.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/hermes-android-foreground.png",
        "monochromeImage": "./assets/images/hermes-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/hermes-favicon.png"
    },
    "plugins": [
      "expo-router",
      ["@hot-updater/expo", { "channel": "preview" }],
      ["expo-secure-store", { "faceIDPermission": "允许 Hermes 移动端使用面容 ID。" }],
      ["expo-image-picker", { "photosPermission": "允许 Hermes 移动端选择要发送的照片。", "cameraPermission": false, "microphonePermission": false }],
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundPlayback": false }],
      "expo-video",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6F4FE",
          "image": "./assets/hermes.icon/Assets/penguin.png",
          "imageWidth": 104
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "45ab06a1-0174-4304-933d-2582320d950f"
      }
    }
  }
}
