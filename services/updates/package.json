{
  "name": "@hermes-mobile/updates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.mjs",
    "build": "esbuild src/main.ts src/setup.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "setup": "tsx src/setup.ts",
    "api-key": "tsx src/setup.ts --create-client-key",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@hot-updater/plugin-core": "1.1.15",
    "@hot-updater/postgres": "1.1.15",
    "@hot-updater/server": "1.1.15",
    "fastify": "^5.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@hot-updater/standalone": "1.1.15",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.0.0",
    "typescript": "~6.0.3"
  }
}
