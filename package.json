{
  "name": "hermes-mobile",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^24.22.1",
    "pnpm": ">=10.14.0"
  },
  "scripts": {
    "dev:services": "bash scripts/start-dev.sh",
    "dev:stop": "bash scripts/stop-dev.sh",
    "dev:mobile": "pnpm --filter @hermes-mobile/mobile start",
    "dev:bff": "pnpm --filter @hermes-mobile/bff dev",
    "dev:connector": "pnpm --filter @hermes-mobile/connector dev",
    "dev:updates": "pnpm --filter @hermes-mobile/updates dev",
    "app:android": "node scripts/mobile-release.mjs android",
    "app:ios": "node scripts/mobile-release.mjs ios",
    "ota:push": "pnpm --filter @hermes-mobile/mobile ota:deploy",
    "ota:fingerprint": "pnpm --filter @hermes-mobile/mobile ota:fingerprint",
    "ota:deploy": "pnpm --filter @hermes-mobile/mobile ota:deploy",
    "ota:console": "pnpm --filter @hermes-mobile/mobile ota:console",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "node --test scripts/test/*.test.mjs && pnpm --recursive --if-present run test"
  }
}
