{
  "name": "hermes-mobile",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.14.0"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @hermes-mobile/mobile start",
    "dev:bff": "pnpm --filter @hermes-mobile/bff dev",
    "dev:connector": "pnpm --filter @hermes-mobile/connector dev",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test"
  }
}
