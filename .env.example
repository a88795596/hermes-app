# 与 Hermes Webapp 进程使用的会话令牌一致
HERMES_DASHBOARD_SESSION_TOKEN=''

# 首次部署时分别生成随机值，更新时保留
APP_PAIRING_TOKEN=
POSTGRES_PASSWORD=

# 开启收件箱投递 API 时另行生成，并在 Hermes 插件配置中使用相同的值
# INBOX_DELIVERY_TOKEN=

# 默认值可省略
# BFF_PORT=4317
# POSTGRES_PORT=55433
# HERMES_WEBAPP_URL=http://127.0.0.1:9120
# HERMES_PROFILES=default

# 有旧 HTTP Runs 会话时保留对应的地址和密钥
# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=''
